# Copy this file to .env and fill in the values before starting Docker Compose.
OPENWEATHER_API_KEY=

# Airflow metadata database and web UI
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=
AIRFLOW_DB_NAME=airflow
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT_URL=http://minio:9000

# Metabase application database and session signing
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=
METABASE_DB_NAME=metabase
METABASE_SESSION_SECRET_KEY=
